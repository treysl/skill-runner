# OpenRouter (required for orchestration; omit to use skill defaults)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Data paths (defaults: ./data and ./outputs under the repo)
DATA_DIR=C:/Users/treyl/skill-runner/data
OUTPUT_DIR=C:/Users/treyl/skill-runner/outputs

# Optional THG logo PNG; leave blank for --no-logo
LOGO_PATH=

# Local API
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8787

# Defaults for n8n / CLI when not passed in the request
DEFAULT_CLIENT_NAME=Client
DEFAULT_USER=n8n

# Advanced: skill package paths (defaults work out of the box)
# SKILL_PACKAGE=C:/Users/treyl/skill-runner/skills/cip-report-06-03-26-tl.skill
# SKILL_CACHE_DIR=C:/Users/treyl/skill-runner/.runner-cache/cip-report-06-03-26-tl
