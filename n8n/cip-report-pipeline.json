{
  "name": "CIP Report — skill-runner",
  "nodes": [
    {
      "parameters": {
        "content": "### Webhook\nProduction entry point. Accepts `POST /cip-report` with `filename`, `client_name`, `user`, and optional `overrides`, then passes the body into the pipeline.",
        "height": 150,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1001-4000-8000-000000000001",
      "name": "Note: Webhook",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, -60]
    },
    {
      "parameters": {
        "content": "### Test trigger\nManual entry for local testing. Runs the same pipeline as the webhook without sending an HTTP request.",
        "height": 130,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1002-4000-8000-000000000002",
      "name": "Note: Test trigger",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, 120]
    },
    {
      "parameters": {
        "content": "### Prepare request\nNormalizes input from either trigger into a single shape: `filename`, `client_name`, `user`, and `overrides` (with defaults when fields are missing).",
        "height": 150,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1003-4000-8000-000000000003",
      "name": "Note: Prepare request",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [260, 40]
    },
    {
      "parameters": {
        "content": "### Run CIP pipeline\nCalls skill-runner at `POST /run` (default `http://127.0.0.1:8787/run`). Inspects the Excel export, orchestrates build settings via OpenRouter, and generates the CIP report.",
        "height": 170,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1004-4000-8000-000000000004",
      "name": "Note: Run CIP pipeline",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [520, 20]
    },
    {
      "parameters": {
        "content": "### Build succeeded?\nBranches on `build.success` from the skill-runner response. True continues to the success payload; false routes to the failure payload.",
        "height": 150,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1005-4000-8000-000000000005",
      "name": "Note: Build succeeded?",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [780, 40]
    },
    {
      "parameters": {
        "content": "### Success payload\nShapes the webhook response for a completed run: `status`, `output_file`, `config`, and an AI validation disclaimer.",
        "height": 140,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1006-4000-8000-000000000006",
      "name": "Note: Success payload",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1040, -60]
    },
    {
      "parameters": {
        "content": "### Failure payload\nShapes the webhook response when the build fails: `status: error` and a `detail` message from the pipeline or HTTP error.",
        "height": 140,
        "width": 300,
        "color": 4
      },
      "id": "b1b2c3d4-1007-4000-8000-000000000007",
      "name": "Note: Failure payload",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1040, 140]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cip-report",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 120],
      "webhookId": "cip-report-skill-runner"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "req-filename",
              "name": "filename",
              "value": "={{ $json.body?.filename ?? $json.filename ?? '' }}",
              "type": "string"
            },
            {
              "id": "req-client",
              "name": "client_name",
              "value": "={{ $json.body?.client_name ?? $json.client_name ?? 'Client' }}",
              "type": "string"
            },
            {
              "id": "req-user",
              "name": "user",
              "value": "={{ $json.body?.user ?? $json.user ?? 'n8n' }}",
              "type": "string"
            },
            {
              "id": "req-overrides",
              "name": "overrides",
              "value": "={{ $json.body?.overrides ?? $json.overrides ?? {} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Prepare request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { filename: $json.filename || null, client_name: $json.client_name, user: $json.user, overrides: $json.overrides || {} } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Run CIP pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "build-success",
              "leftValue": "={{ $json.build.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Build succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "out-status",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "out-file",
              "name": "output_file",
              "value": "={{ $json.build.output_file }}",
              "type": "string"
            },
            {
              "id": "out-config",
              "name": "config",
              "value": "={{ $json.config }}",
              "type": "object"
            },
            {
              "id": "out-disclaimer",
              "name": "disclaimer",
              "value": "Please note: this report was generated by AI and should be validated before use.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Success payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1060, 120]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fail-status",
              "name": "status",
              "value": "error",
              "type": "string"
            },
            {
              "id": "fail-detail",
              "name": "detail",
              "value": "={{ $json.detail ?? $json.message ?? 'CIP build failed' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Failure payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1060, 320]
    }
  ],
